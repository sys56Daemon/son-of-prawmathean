# WhatsApp Bot Environment Configuration Template
# Copy this file to .env and fill in your values.

# WhatsApp bot prefix (default: .)
BOT_PREFIX=.

# Owner WhatsApp Numbers / LIDs (comma-separated, international format without + or spaces)
OWNER_NUMBERS=YOUR_PHONE_NUMBER_HERE

# Legacy fallback single number/LID
OWNER_NUMBER=YOUR_PHONE_NUMBER_HERE
OWNER_LID=YOUR_LID_HERE

# Groq AI Configuration
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# UPI ID for donations/support (optional)
UPI_ID=your_upi_id@bank

# Private mode (true/false)
BOT_PRIVATE=false

# Allowed numbers when BOT_PRIVATE=true (comma-separated)
ALLOWED_NUMBERS=YOUR_PHONE_NUMBER_HERE
